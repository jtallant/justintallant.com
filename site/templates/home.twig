{% extends 'layouts/master' %}

{% block title %}
    {{ skimpy.site.title }} - {{ skimpy.site.tagline }}
{% endblock title %}

{% block styles %}
<style>
    #header-photo img {
        display: none;
    }
</style>
{% endblock styles %}

{% block metaDescription %}
    <meta name="description" content="{{ skimpy.site.meta_description }}">
{% endblock metaDescription %}

{% block content %}
    <div id="home">
        <img src="/img/author.jpg" alt="Justin Tallant" class="justin-photo">

        <div id="bio">
            <h1>
                Senior Staff Engineer.<br>Application architecture.
            </h1>

            <p>
                I'm Justin, a senior staff engineer focused on application architecture and code organization.
            </p>
        </div>

        <div class="socials">
            <a aria-label="Follow on GitHub" href="https://github.com/jtallant" target="_blank">
                {% include 'svg/github.twig' %}
            </a>
            <a aria-label="Follow on LinkedIn" href="https://www.linkedin.com/in/justintallant" target="_blank">
                {% include 'svg/linkedin.twig' %}
            </a>
            <a aria-label="Follow on X" href="https://x.com/tallantdev" target="_blank">
                {% include 'svg/twitter.twig' %}
            </a>
        </div>

        {# PHOTOS #}
        <div id="home-photos">
            <img src="/img/justin.jpg" alt="Justin at White Sands National Park" loading="lazy">
            <img src="/img/firepit.jpg" alt="Huckleberry cabin patio" loading="lazy">
            <img src="/img/pickleball.jpg" alt="Justin playing pickleball" loading="lazy">
        </div>

        <div id="home-bottom">
            {# ARTICLES #}
            <div class="articles">
                {% for entry in entries %}
                    {% include 'partials/article' %}
                {% endfor %}
            </div>
        </div> <!-- #home-bottom -->
    </div> <!-- #home -->
{% endblock content %}
